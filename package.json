{
  "name": "nrb-europe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env.dev -- next dev",
    "build": "next build",
    "build:dev": "dotenv -e .env.dev -- next build",
    "build:prod": "dotenv -e .env.prod -- next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "start:prod": "dotenv -e .env.prod -- next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "setup-admin": "node run-setup.js",
    "seed": "dotenv -e .env.dev -- tsx scripts/create-admin.ts",
    "postinstall": "prisma generate",
    "db:migrate": "dotenv -e .env.dev -- npx prisma migrate dev",
    "db:push": "dotenv -e .env.dev -- npx prisma db push",
    "db:studio": "dotenv -e .env.dev -- npx prisma studio",
    "db:migrate:prod": "dotenv -e .env.prod -- npx prisma migrate deploy",
    "deploy-schema": "dotenv -e .env.dev -- npx sanity schema deploy",
    "seo-audit": "node scripts/seo-audit.js"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@portabletext/react": "^6.0.2",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^1.2.0",
    "@sanity/vision": "^4.22.0",
    "@sentry/nextjs": "^10.40.0",
    "@stripe/stripe-js": "^8.8.0",
    "@vercel/analytics": "^1.6.1",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "ioredis": "^5.10.0",
    "lucide-react": "^0.563.0",
    "next": "^16.1.6",
    "next-auth": "^4.24.13",
    "next-sanity": "^12.0.16",
    "next-sitemap": "^4.2.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.7.0",
    "resend": "^6.9.3",
    "sanity": "^5.8.1",
    "server-only": "^0.0.1",
    "stripe": "^20.4.0",
    "styled-components": "^6.3.8",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.16",
    "dotenv-cli": "^11.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.32",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.3.6",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  }
}
